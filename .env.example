# ---------------------------------------------------------------------------
# jimbo-backup
# Copy to .env and adjust. Never commit .env: it can hold database passwords.
# The backups themselves are files in jobs/ — see jobs/README.md.
# ---------------------------------------------------------------------------

TZ=America/Toronto

# --- Docker -----------------------------------------------------------------
# Running Immich (or anything whose database a job dumps)? Join its network by
# adding the override file. Leave this commented out on a machine without it.
# COMPOSE_FILE=docker-compose.yml:docker-compose.immich.yml
# The network Immich's Postgres is on (only used with the override above).
IMMICH_NETWORK=immich_default
CONTAINER_NAME=jimbo-backup
# Postgres client version built into the image. A newer pg_dump can always dump
# an older server, so raise this only if a database ever outruns it.
PG_MAJOR=17

# --- Paths (on the host) ----------------------------------------------------
# Where drives are mounted. /Volumes on a Mac; /mnt or /media on Linux.
# Job files' paths under here work as written.
HOST_VOLUMES_DIR=/Volumes
# Logs, state.json and theme.json. Somewhere that's always mounted.
LOG_DIR_HOST=/Volumes/your-data-drive/logs/jimbo-backup

# --- Schedule ---------------------------------------------------------------
# At each run, every job in jobs/ runs in file-name order (except
# JOB_SCHEDULE=manual ones). BACKUP_INTERVAL accepts:
#   daily    every day at BACKUP_TIME
#   weekly   every BACKUP_DAY at BACKUP_TIME
#   hourly   every hour
#   <N>h     every N hours   (e.g. 6h)
#   <N>d     every N days at BACKUP_TIME  (e.g. 3d)
#   off      no schedule; the dashboard's Back up buttons still work
BACKUP_INTERVAL=daily
BACKUP_TIME=03:00
# Only used when BACKUP_INTERVAL=weekly. Lowercase day name.
BACKUP_DAY=sunday

# --- rsync ------------------------------------------------------------------
# The default for every job; a job can set its own JOB_RSYNC_FLAGS.
# --no-p --no-g --no-o are needed on Docker Desktop, whose file sharing can't
# chown/chmod through a bind mount, even on APFS. -t (keep modification times)
# is what lets rsync skip unchanged files. Don't drop it.
RSYNC_FLAGS=-rtvh --delete --no-p --no-g --no-o

# --- Databases ---------------------------------------------------------------
# Read by postgres_dump (scripts/hooks.sh), which the Immich jobs call. These are
# the names Immich's own .env uses. A job can override them (PG_HOST, PG_USER,
# PG_DATABASE, PG_PASSWORD) for a different database.
DB_HOSTNAME=immich_postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# If your password contains a literal $, double it ($$) -- Docker Compose
# treats a single $ as the start of a variable reference.
DB_PASSWORD=changeme
# How many dated Immich dumps to keep.
IMMICH_DUMP_KEEP=7

# --- Dashboard --------------------------------------------------------------
GUI_PORT=4343
# Who can reach the dashboard.
#   0.0.0.0    the LAN and the tailnet
#   127.0.0.1  this machine only; SSH-tunnel in from elsewhere
# There is NO authentication, so 0.0.0.0 means anything on your network can
# start a backup. Fine on a network that's only yours.
#
# Don't set this to a literal tailnet IP (100.x.y.z): if Docker starts before
# Tailscale after a reboot, the container can't bind it and restart-loops. For
# tailnet-only access keep 127.0.0.1 and run `tailscale serve --bg 4343`.
GUI_BIND=0.0.0.0
# A backup is flagged stale when its last good copy is older than this.
STALE_WARN_HOURS=48

# --- Logs -------------------------------------------------------------------
LOG_RETENTION_DAYS=30
