{
  "version": "0.8.3",
  "webRoot": "web",
  "reference": {
    "web/index.html": "web/index.html",
    "web/src/components/ui/kit.tsx": "web/src/components/ui/jimbo-kit.tsx (exact copy; this app's pieces are in kit.tsx)",
    "web/src/components/HeaderTitle.tsx": "web/src/components/HeaderTitle.tsx",
    "web/src/lib/useBrand.ts": "web/src/lib/useBrand.ts",
    "web/src/routes/AppShell.tsx": "web/src/routes/AppShell.tsx",
    "web/src/routes/JimboConfigPage.tsx": "web/src/routes/JimboConfigPage.tsx (no favicon upload)",
    "web/src/routes/config/ThemePanel.tsx": "web/src/routes/config/ThemePanel.tsx",
    "web/src/routes/config/StyleGuidePanel.tsx": "web/src/routes/config/StyleGuidePanel.tsx (plus a \"This app\" block)"
  },
  "auth": "none",
  "components": {
    "overrides": [
      {
        "name": "KeyValue",
        "path": "web/src/components/ui/kit.tsx",
        "reason": "The kit's KeyValue is a <div>; inside divide-etched, the one-level-down rule draws a line between its label and value. This app's is a <p>."
      }
    ]
  }
}
